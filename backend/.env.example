# The web API currently defaults to a Claude model, so use Anthropic for web setup.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# CLI alternative: set LLM_PROVIDER=nvidia and provide your NVIDIA key.
# The web API also needs an explicit NVIDIA model in its request; see README.md.
# NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# ANTHROPIC_MODEL=claude-opus-4-5

# Optional repository intelligence and indexed Slack context
# NIA_API_KEY=your-nia-api-key
# NIA_SLACK_SOURCE=your-indexed-slack-source

# Optional Sentry log analysis
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
# SENTRY_ORG=your-organization-slug
# SENTRY_PROJECT=your-project-slug

# Optional Git credentials for the patch agent; GitHub CLI must also be installed.
# GITHUB_TOKEN=your-github-token
